configuration {
    display-drun: "Applications:";
    display-window: "Windows:";
    drun-display-format: "{icon} {name}";
    font: "JetBrainsMono Nerd Font Medium 10";
    modi: "window,run,drun";
    show-icons: true;
    icon-theme: "Papirus";
}
* {
    bg:       #11121D;
    bg-alt:   #162a83ff;
    fg:       #FFFFFF;
    fg-alt:   #042525ff;

    background-color: @bg;
    border: 0;
    margin: 0;
    padding: 5px;
    spacing: 5px;
}


#element selected {
    background-color: @bg-alt;
    color: @fg-alt;
}

